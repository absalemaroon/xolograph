# --- dependencies / build output ---
node_modules/
.next/
dist/
build/
out/
.turbo/
coverage/
.vite/
*.tsbuildinfo

# --- environment & secrets ---
.env
.env.local
.env.*.local

# --- logs / OS / editors ---
*.log
.DS_Store
.vscode/
.idea/

# --- Xolograph runtime data (never commit evidence or case databases) ---
.data/
*.db
*.db-wal
*.db-shm
*.db-journal

# --- Go ---
/backend/bin/
*.exe
*.test
*.out

# --- Tauri (src-tauri lives at the repo root) ---
/src-tauri/target/
/src-tauri/gen/
# Engine sidecar binaries are build artifacts (created by `npm run engine:build`)
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep
